\cs_new_protected:Npn \__study_error:nn #1#2
 { \PackageError{studytools}{#1}{#2} }
\cs_new_protected:Npn \__study_check_id:n #1
 {
  \regex_match:nnF {\A [A-Za-z] [-A-Za-z0-9._:]* \Z} {#1}
   {\__study_error:nn {Invalid~study~ID:~#1}{Use~a~letter,~then~letters,~digits,~dot,~colon,~underscore~or~hyphen.}}
  \prop_if_in:NnT \g__study_kind_prop {#1}
   {\__study_error:nn {Duplicate~study~ID:~#1}{Every~concept,~subentry~and~route~needs~its~own~stable~ID.}}
 }
\keys_define:nn {study/record}
 {
  lookup .tl_set:N = \l__study_group_tl,
  notes-source .tl_set:N = \l__study_notes_source_tl,
  header-left .tl_set:N = \l__study_short_left_tl,
  header-right .tl_set:N = \l__study_short_right_tl,
  context-left .tl_set:N = \l__study_context_left_tl,
  context-right .tl_set:N = \l__study_context_right_tl
 }
\keys_define:nn {study}
 {

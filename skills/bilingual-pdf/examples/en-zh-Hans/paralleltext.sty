 \ifdim\PTKeepHeight>\dimexpr\textheight-8mm\relax\PackageError{paralleltext}{GROUP TOO TALL}{Split at a matching semantic boundary.}\fi
 \PTReserveSpace{\PTKeepHeight}\noindent\usebox\PTKeepBox\par\PTAfterHeadingfalse}

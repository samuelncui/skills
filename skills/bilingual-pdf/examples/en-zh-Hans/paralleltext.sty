\newcommand\PTValidateGeometry{%
 \ifdim\ParallelDividerWidth>0pt\else\PackageError{paralleltext}{Divider width must be positive}{Set divider-width to a positive length, or divider=false.}\fi
 \ifdim\ParallelTabInset<0pt\PackageError{paralleltext}{Tab inset must not be negative}{Use a nonnegative tab-inset.}\fi
 \ifdim\ParallelTabWidth>0pt\else\PackageError{paralleltext}{Tab width must be positive}{Use a positive tab-width.}\fi
 \ifdim\ParallelTabHeight>0pt\else\PackageError{paralleltext}{Tab height must be positive}{Use a positive tab-height.}\fi
 \ifdim\ParallelTabStep>0pt\else\PackageError{paralleltext}{Tab step must be positive}{Use a positive tab-step.}\fi

 \ifdim\ParallelColumnGap<0pt\PackageError{paralleltext}{Column gap must not be negative}{Set column-gap to a nonnegative length.}\fi
 \ifdim\ParallelBodySize pt>0pt\else\PackageError{paralleltext}{Body size must be positive}{Set body-size in points.}\fi
 \ifdim\ParallelBodyLeading pt<\ParallelBodySize pt\PackageError{paralleltext}{Body leading is smaller than body size}{Choose readable line spacing.}\fi
 \setlength\PTWidth{\PTAvailableWidth}%
 \ifdefstring{\ParallelMode}{paired}{\setlength\PTWidth{\dimexpr(\textwidth-\ParallelColumnGap)/2\relax}%
  \if@twocolumn\PackageError{paralleltext}{Paired mode cannot use standard twocolumn}{Use paired mode in one-column article, or select one language.}\fi}{}%
 \ifdim\PTWidth<\ParallelMinimumColumnWidth\PackageError{paralleltext}{Content columns too narrow}{Adjust geometry or column-gap; do not shrink the manuscript.}\fi
 \ifdim\textheight<30mm\PackageError{paralleltext}{Text height too small}{Adjust geometry.}\fi}

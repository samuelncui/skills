# Private source material, diagnostics, downloads and build matrices
/.local/
.env
.env.*
.venv/
venv/

# Python caches and packaging
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
build/
dist/
*.egg-info/

# Transient TeX output; only the nine curated example PDFs are tracked.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!/skills/bilingual-pdf/examples/*/output.pdf

# Native study build selection is generated per project.
.build-products.tex
!/skills/study-notes/examples/notes.pdf
!/skills/study-notes/examples/quick-reference.pdf
!/skills/study-notes/examples/keyword-index.pdf
!/skills/study-notes/examples/decision-tree.pdf

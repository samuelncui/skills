{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bilingual HTML embedded-pair layout v1",
  "description": "Literal paired text only. Runtime also checks duplicate IDs/JSON keys, control characters, rectangular tables, local PNG/JPEG paths and assets. No translation dependency.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "layout_version": {
      "const": 1,
      "type": "integer"
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/language"
        },
        "target": {
          "$ref": "#/$defs/language"
        }
      },
      "required": [
        "source",
        "target"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser_title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "desktop_order": {
          "enum": [
            "source-first",
            "target-first"
          ]
        },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_width": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:rem|em|px|ch)$",
              "description": "Runtime additionally requires value > 0 and <= 1000."
            },
            "column_gap": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:rem|em|px|ch)$",
              "description": "Runtime additionally requires value > 0 and <= 1000."
            },
            "block_gap": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:rem|em|px|ch)$",
              "description": "Runtime additionally requires value > 0 and <= 1000."
            },
            "font_size": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:rem|em|px|ch)$",
              "description": "Runtime additionally requires value > 0 and <= 1000."
            },
            "page_padding": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:rem|em|px|ch)$",
              "description": "Runtime additionally requires value > 0 and <= 1000."
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "source_font": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,79}$"
              }
            },
            "target_font": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,79}$"
              }
            },
            "source_weight": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 4
            },
            "target_weight": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 4
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 4
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heading"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "pair": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "type",
              "level",
              "pair"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "paragraph"
              },
              "pair": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "type",
              "pair"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "list"
              },
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/pair"
                }
              }
            },
            "required": [
              "type",
              "ordered",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "table"
              },
              "headers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/pair"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/pair"
                  }
                }
              },
              "caption": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "type",
              "headers",
              "rows"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "figure"
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "description": "Relative local PNG/JPEG with no traversal, URL, backslashes or symlinks; runtime validates."
              },
              "caption": {
                "$ref": "#/$defs/pair"
              },
              "alt": {
                "$ref": "#/$defs/pair"
              }
            },
            "required": [
              "type",
              "asset",
              "caption",
              "alt"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "layout_version",
    "languages",
    "blocks"
  ],
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ]
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "dir": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      },
      "required": [
        "tag",
        "dir"
      ]
    }
  }
}

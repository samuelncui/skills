\NewDocumentCommand \StudyDeclareNotesSource {m m m m m}
 {
  \prop_if_in:NnT \g__study_docs_left_prop {#1}
   {\__study_error:nn {Duplicate~notes~source~#1}{Each~external~document~needs~a~unique~source~ID.}}
  \prop_gput:Nnn \g__study_docs_left_prop {#1}{#2}
  \prop_gput:Nnn \g__study_docs_right_prop {#1}{#3}
  \externaldocument[study-notes-#1-]{#4}[#5]
  \StudyHasNotestrue
 }
\cs_new_protected:Npn \__study_notes:nn #1#2
 {
  \prop_get:NnNT \g__study_notes_source_prop {#1}\l__study_doc_tl
   {
    \prop_if_in:NVTF \g__study_docs_left_prop \l__study_doc_tl
     {
      \prop_get:NnNT \g__study_notes_prop {#1}\l_tmpa_tl
       {
        \tl_if_blank:VF \l_tmpa_tl
         {
          \hyperref[study-notes-\l__study_doc_tl-\l_tmpa_tl]
           {\str_if_eq:nnTF{#2}{left}
             {\StudyNotesLocationLeft{\prop_item:NV\g__study_docs_left_prop\l__study_doc_tl}{\ref*{study-notes-\l__study_doc_tl-\l_tmpa_tl}}{\pageref*{study-notes-\l__study_doc_tl-\l_tmpa_tl}}}
             {\StudyNotesLocationRight{\prop_item:NV\g__study_docs_right_prop\l__study_doc_tl}{\ref*{study-notes-\l__study_doc_tl-\l_tmpa_tl}}{\pageref*{study-notes-\l__study_doc_tl-\l_tmpa_tl}}}}
         }
       }
     }{}
   }
 }

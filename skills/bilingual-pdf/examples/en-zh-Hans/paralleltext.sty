\newcommand\PTCurrentEntryId{}\newcommand\PTCurrentEntryText{}
\newcommand\PTCurrentNavigation{}
\newcommand\PTPreviousEntry{}\newcommand\PTPreviousEntryPage{0}
\newcommand\PTPreviousNavigation{}\newcommand\PTPreviousNavigationPage{0}
\newcommand\PTSetEntryPage[3]{%
 \ifcsname pt@first@#1\endcsname\else\expandafter\gdef\csname pt@first@#1\endcsname{#3}\fi
 \expandafter\gdef\csname pt@last@#1\endcsname{#3}}
\newcommand\PTPageEntry[3]{%
 \def\PTThisEntry{#2}\@tempcnta=#1\relax
 \ifx\PTThisEntry\PTPreviousEntry\@tempcnta=\PTPreviousEntryPage\relax\fi
 \loop\PTSetEntryPage{\number\@tempcnta}{#2}{#3}\ifnum\@tempcnta<#1\advance\@tempcnta by1\repeat
 \gdef\PTPreviousEntry{#2}\gdef\PTPreviousEntryPage{#1}}
\newcommand\PTPageNavigation[2]{%
 \def\PTThisNavigation{#2}\@tempcnta=#1\relax
 \ifx\PTThisNavigation\PTPreviousNavigation\@tempcnta=\PTPreviousNavigationPage\relax\fi
 \loop\expandafter\gdef\csname pt@nav@\number\@tempcnta @#2\endcsname{1}%
 \ifnum\@tempcnta<#1\advance\@tempcnta by1\repeat
 \gdef\PTPreviousNavigation{#2}\gdef\PTPreviousNavigationPage{#1}}
\newcommand\PTRecordFurniture{%
 \ifdefempty{\PTCurrentEntryId}{}{\protected@write\@auxout{\let\PTPhysicalPage\relax}{%
  \string\PTPageEntry{\PTPhysicalPage}{\PTCurrentEntryId}{\PTCurrentEntryText}}}%
 \ifdefempty{\PTCurrentNavigation}{}{\protected@write\@auxout{\let\PTPhysicalPage\relax}{%
  \string\PTPageNavigation{\PTPhysicalPage}{\PTCurrentNavigation}}}}
\apptocmd{\PTRecordPhysical}{\PTRecordFurniture}{}{}
\newcommand\PTEntryHead[1]{\begingroup
 \ifdefstring{\ParallelMode}{right}{\selectlanguage{\ParallelRightLanguage}}{\selectlanguage{\ParallelLeftLanguage}}%
 \ifcsname pt@#1@\number\numexpr\ReadonlyShipoutCounter+1\relax\endcsname
  \csname pt@#1@\number\numexpr\ReadonlyShipoutCounter+1\relax\endcsname\fi\endgroup}

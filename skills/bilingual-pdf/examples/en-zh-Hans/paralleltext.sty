\NewDocumentCommand\ParallelEndNavigation{}{\gdef\PTCurrentNavigation{}\gdef\ParallelStructureColor{parallel.theme}}
\newcommand\PTDrawTab[1]{%
 \ifcsname pt@nav@\number\ReadonlyShipoutCounter @#1\endcsname
  \def\PTTabEdge{right}%
  \ifdefstring{\ParallelTabSide}{left}{\def\PTTabEdge{left}}{}%
  \ifdefstring{\ParallelTabSide}{outer}{\if@twoside\ifodd\value{page}\else\def\PTTabEdge{left}\fi\fi}{}%
  \ifdefstring{\ParallelTabSide}{inner}{\def\PTTabEdge{left}\if@twoside\ifodd\value{page}\else\def\PTTabEdge{right}\fi\fi}{}%
  \edef\PTTabY{\the\dimexpr\ParallelTabTop+\ParallelTabStep*\numexpr\csname pt@navslot@#1\endcsname-1\relax\relax}%
  \ifdim\dimexpr\PTTabY+\ParallelTabHeight\relax>\paperheight
   \PackageError{paralleltext}{Navigation tab outside page}{Reduce slot count, tab-top, tab-step or tab-height.}\fi
  \begin{tikzpicture}[remember picture,overlay]
  \tikzset{parallel tab/.style/.expanded={fill=\csname pt@navcolor@#1\endcsname!8,draw=\csname pt@navcolor@#1\endcsname,\ParallelTabStyle}}%
  \ifdefstring{\PTTabEdge}{right}{%
   \node[parallel tab,anchor=north east,minimum width=\ParallelTabWidth,minimum height=\ParallelTabHeight,font=\ParallelTabTextStyle]
    at ([xshift=-\ParallelTabInset,yshift=-\PTTabY]current page.north east){\PTFurniture{\rotatebox{\ParallelTabRotation}{\csname pt@navlabel@#1\endcsname}}};%
  }{%
   \node[parallel tab,anchor=north west,minimum width=\ParallelTabWidth,minimum height=\ParallelTabHeight,font=\ParallelTabTextStyle]
    at ([xshift=\ParallelTabInset,yshift=-\PTTabY]current page.north west){\PTFurniture{\rotatebox{\ParallelTabRotation}{\csname pt@navlabel@#1\endcsname}}};%
  }\end{tikzpicture}\fi}
\AddToHook{shipout/background}{\ifPTBody\ifPTTabs\forlistloop\PTDrawTab\PTNavigationList\fi\fi}

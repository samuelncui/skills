\cs_new_protected:Npn \__study_record:nnnnnn #1#2#3#4#5#6
 {
  \__study_check_id:n {#2}
  \tl_set:Nn \l__study_group_tl {#2}
  \tl_set:Nn \l__study_notes_source_tl {notes}
  \tl_set:Nn \l__study_short_left_tl {#4}
  \tl_set:Nn \l__study_short_right_tl {#5}
  \tl_clear:N \l__study_context_left_tl
  \tl_clear:N \l__study_context_right_tl
  \keys_set:nn {study/record}{#1}
  \tl_if_blank:nT {#3}
   {\__study_error:nn {Empty~sort~key~for~#2}{Supply~an~explicit~sort~key;~display~titles~are~not~parsed.}}
  \prop_gput:NnV \g__study_group_prop {#2}\l__study_group_tl
  \prop_gput:NnV \g__study_notes_source_prop {#2}\l__study_notes_source_tl
  \prop_gput:NnV \g__study_short_left_prop {#2}\l__study_short_left_tl
  \prop_gput:NnV \g__study_short_right_prop {#2}\l__study_short_right_tl
  \prop_gput:Nnn \g__study_sort_prop {#2}{#3}
  \prop_gput:Nnn \g__study_left_prop {#2}{#4}
  \prop_gput:Nnn \g__study_right_prop {#2}{#5}
  \prop_gput:Nnn \g__study_kind_prop {#2}{#6}
  \prop_gput:NnV \g__study_context_left_prop {#2}\l__study_context_left_tl
  \prop_gput:NnV \g__study_context_right_prop {#2}\l__study_context_right_tl
  \prop_get:NVNTF \g__study_group_sort_prop \l__study_group_tl \l_tmpa_tl
   {\tl_if_eq:VnF \l_tmpa_tl {#3}
     {\__study_error:nn {Lookup~group~has~different~sort~keys}{Records~sharing~lookup=~must~use~one~identical~sort~key.}}}
   {\prop_gput:NVn \g__study_group_sort_prop \l__study_group_tl {#3}}
  \seq_gput_right:Nn \g__study_records_seq {#2}
 }
\NewDocumentCommand \StudyDeclareConcept {O{} m m m m m +m}
 {
  \__study_record:nnnnnn {#1}{#2}{#3}{#4}{#5}{concept}
  \prop_gput:Nnn \g__study_notes_prop {#2}{#6}
  \prop_gput:Nnn \g__study_body_prop {#2}{#7}
 }
\NewDocumentCommand \StudyDeclareRoute {O{} m m m m}
 {
  \__study_record:nnnnnn {#1}{#2}{#3}{#4}{#5}{route}
  \seq_new:c {g__study_targets_#2_seq}
 }
\NewDocumentCommand \StudyRouteTarget {m m m m}
 {
  \prop_get:NnNTF \g__study_kind_prop {#1}\l_tmpa_tl
   {
    \str_if_eq:VnTF \l_tmpa_tl {route}
     {\seq_gput_right:cn {g__study_targets_#1_seq}{{#2}{#3}{#4}}}
     {\__study_error:nn {Target~owner~#1~is~not~a~route}{Use~StudyDeclareRoute~before~StudyRouteTarget.}}
   }
   {\__study_error:nn {Unknown~route~#1}{Declare~the~route~before~its~target~rows.}}
 }
\NewDocumentCommand \StudyDeclareAlias {O{} m m m m m}
 {
  \StudyDeclareRoute[#1]{#2}{#3}{#4}{#5}
  \StudyRouteTarget{#2}{#6}{}{}
 }
\NewDocumentCommand \StudyDeclareSubentry {m m m m m}
 {
  \__study_check_id:n {#1}
  \prop_gput:Nnn \g__study_kind_prop {#1}{subentry}
  \prop_gput:Nnn \g__study_parent_prop {#1}{#2}
  \prop_gput:Nnx \g__study_notes_source_prop {#1}{\prop_item:Nn\g__study_notes_source_prop{#2}}
  \prop_gput:Nnn \g__study_left_prop {#1}{#3}
  \prop_gput:Nnn \g__study_right_prop {#1}{#4}
  \prop_gput:Nnn \g__study_notes_prop {#1}{#5}
  \seq_gput_right:Nn \g__study_subentries_seq {#1}
 }
\cs_new_protected:Npn \__study_check_target:nnn #1#2#3
 {
  \prop_get:NnNTF \g__study_kind_prop {#1}\l_tmpa_tl
   {
    \str_if_eq:VnT \l_tmpa_tl {route}
     {\__study_error:nn {Route~target~#1~is~another~route}{Target~a~canonical~concept~or~subentry;~alias~chains~are~not~allowed.}}
   }
   {\__study_error:nn {Unknown~study~target~#1}{Declare~the~canonical~concept~or~subentry~before~the~document~starts.}}
 }
\cs_new_protected:Npn \__study_validate:
 {
  \prop_clear:N\l__study_group_counts_prop
  \seq_map_inline:Nn\g__study_records_seq
   {\prop_get:NnN\g__study_kind_prop{##1}\l_tmpa_tl
    \str_if_eq:VnT\l_tmpa_tl{concept}
     {\prop_get:NnN\g__study_group_prop{##1}\l_tmpa_tl
      \prop_get:NVNTF\l__study_group_counts_prop\l_tmpa_tl\l_tmpb_tl
       {\prop_put:NVx\l__study_group_counts_prop\l_tmpa_tl{\int_eval:n{\l_tmpb_tl+1}}}
       {\prop_put:NVn\l__study_group_counts_prop\l_tmpa_tl{1}}}}
  \seq_map_inline:Nn\g__study_records_seq
   {\prop_get:NnN\g__study_kind_prop{##1}\l_tmpa_tl
    \str_if_eq:VnT\l_tmpa_tl{concept}
     {\prop_get:NnN\g__study_group_prop{##1}\l_tmpa_tl
      \prop_get:NVN\l__study_group_counts_prop\l_tmpa_tl\l_tmpb_tl
      \int_compare:nNnT{\l_tmpb_tl}>{1}
       {\prop_get:NnN\g__study_context_left_prop{##1}\l_tmpa_tl
        \tl_if_blank:VT\l_tmpa_tl{\__study_error:nn{Missing~left~sense~label~for~##1}{Shared~lookup~groups~with~several~concepts~need~paired~context~labels.}}
        \prop_get:NnN\g__study_context_right_prop{##1}\l_tmpa_tl
        \tl_if_blank:VT\l_tmpa_tl{\__study_error:nn{Missing~right~sense~label~for~##1}{Shared~lookup~groups~with~several~concepts~need~paired~context~labels.}}}}}

  \seq_map_inline:Nn \g__study_records_seq
   {
    \prop_get:NnN \g__study_kind_prop {##1}\l_tmpa_tl
    \str_if_eq:VnT \l_tmpa_tl {route}
     {
      \seq_if_empty:cT {g__study_targets_##1_seq}
       {\__study_error:nn {Route~##1~has~no~targets}{Add~at~least~one~StudyRouteTarget.}}
      \seq_map_inline:cn {g__study_targets_##1_seq}{\__study_check_target:nnn ####1}
     }
   }
  \seq_map_inline:Nn \g__study_subentries_seq
   {
    \prop_get:NnN \g__study_parent_prop {##1}\l_tmpa_tl
    \prop_get:NVNTF \g__study_kind_prop \l_tmpa_tl \l_tmpb_tl
     {\str_if_eq:VnF \l_tmpb_tl {concept}
       {\__study_error:nn {Subentry~##1~has~a~non-concept~parent}{Use~a~canonical~concept~ID.}}}
     {\__study_error:nn {Subentry~##1~has~an~unknown~parent}{Declare~its~canonical~concept.}}
   }
 }

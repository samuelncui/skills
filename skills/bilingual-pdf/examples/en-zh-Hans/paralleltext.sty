\NewDocumentCommand\ParallelBackCover{m m}{%
 \clearpage\PTSaveColumns\onecolumn\begingroup\PTBodyfalse\pagestyle{empty}\hypersetup{pageanchor=false}%
 % Physical parity remains correct even after \pagenumbering resets the folio.
 \ifPTBlankInsideBack
  \ifdefstring{\ParallelBackParity}{even}{\ifodd\ReadonlyShipoutCounter\PTBlankPage\fi}{}%
  \ifdefstring{\ParallelBackParity}{odd}{\ifodd\ReadonlyShipoutCounter\else\PTBlankPage\fi}{}%
  \PTBlankPage
 \else
  \ifdefstring{\ParallelBackParity}{even}{\ifodd\ReadonlyShipoutCounter\else\PTBlankPage\fi}{}%
  \ifdefstring{\ParallelBackParity}{odd}{\ifodd\ReadonlyShipoutCounter\PTBlankPage\fi}{}%
 \fi
 \thispagestyle{empty}\vspace*{\ParallelCoverTop}\PTCoverTitles{#1}{#2}\vfill\ParallelCoverBottom\clearpage\endgroup\PTRestoreColumns}

# Private source material, diagnostics, downloads and build matrices
/.local/
.env
.env.*
.venv/
venv/

# Python caches and packaging
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
build/
dist/
*.egg-info/

# Transient TeX output; only the six curated example PDFs are tracked.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!/examples/bilingual-pdf/*/document.pdf
!/examples/course-guide-quick-reference/*/notes.pdf
!/examples/course-guide-quick-reference/*/quick-reference.pdf

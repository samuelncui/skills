{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "languages": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/language"
        },
        "target": {
          "$ref": "#/$defs/language"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      },
      "minItems": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "minItems": 1
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "source_revision": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "schema_version",
    "languages",
    "units",
    "blocks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bilingual translation exchange v1",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f\\u202a-\\u202e\\u2066-\\u2069\\ud800-\\udfff]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "language": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
        },
        "dir": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      },
      "required": [
        "tag",
        "dir"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list_item",
            "table_cell",
            "caption",
            "alt_text"
          ]
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "target_source_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "untranslated",
            "draft",
            "reviewed",
            "needs_review"
          ]
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "section": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "source_hash",
        "target_source_hash",
        "status"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/$defs/text"
        },
        "audience": {
          "$ref": "#/$defs/text"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "#/$defs/text"
              },
              "target": {
                "$ref": "#/$defs/text"
              },
              "note": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "heading"
            },
            "unit": {
              "$ref": "#/$defs/id"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "required": [
            "type",
            "unit",
            "level"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "unit": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "type",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "ordered",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "table"
            },
            "headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              },
              "minItems": 1
            },
            "caption": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "type",
            "headers",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "figure"
            },
            "asset": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_-](?:[A-Za-z0-9_./-]*[A-Za-z0-9_-])?(?![\\s\\S])"
            },
            "caption": {
              "$ref": "#/$defs/id"
            },
            "alt": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "type",
            "asset",
            "caption",
            "alt"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

 {\str_if_eq:eeTF{\prop_item:Nn\g__study_kind_prop{#1}}{\prop_item:Nn\g__study_kind_prop{#2}}
   {\__study_compare_ids:nn{#1}{#2}}
   {\str_compare:eNeTF{\prop_item:Nn\g__study_kind_prop{#1}}>{\prop_item:Nn\g__study_kind_prop{#2}}{\sort_return_swapped:}{\sort_return_same:}}}
\cs_new_protected:Npn \__study_compare_group:nn #1#2
 {\str_if_eq:eeTF{\prop_item:Nn\g__study_group_prop{#1}}{\prop_item:Nn\g__study_group_prop{#2}}
   {\__study_compare_kind:nn{#1}{#2}}
   {\str_compare:eNeTF{\prop_item:Nn\g__study_group_prop{#1}}>{\prop_item:Nn\g__study_group_prop{#2}}{\sort_return_swapped:}{\sort_return_same:}}}
\cs_new_protected:Npn \__study_compare:nn #1#2

 \gdef\PTCurrentEntryId{#1}%
 \ifdefstring{\ParallelMode}{right}{\gdef\PTCurrentEntryText{#3}}{\gdef\PTCurrentEntryText{#2}}%
 \PTHeadingtrue\let\PTHeadingReservation\ParallelSubsectionSpace\ParallelText{#1}{{\ParallelEntryStyle #2}}{{\ParallelEntryStyle #3}}\PTHeadingfalse}
\NewDocumentCommand\ParallelEndEntry{}{\gdef\PTCurrentEntryId{}\gdef\PTCurrentEntryText{}}
\newcommand\PTNavigationList{}
\NewDocumentCommand\ParallelDeclareNavigation{O{parallel.theme} m m m}{%
 \ifnum#3<1\PackageError{paralleltext}{Navigation slot must be positive}{Use a positive integer slot.}\fi
 \ifcsname pt@navslot@#2\endcsname\PackageError{paralleltext}{Duplicate navigation ID #2}{Each navigation ID must be unique.}\fi
 \@namedef{pt@navcolor@#2}{#1}\@namedef{pt@navslot@#2}{#3}\@namedef{pt@navlabel@#2}{#4}\listadd\PTNavigationList{#2}}
\@onlypreamble\ParallelDeclareNavigation
\NewDocumentCommand\ParallelNavigation{m}{%
 \ifcsname pt@navslot@#1\endcsname\gdef\PTCurrentNavigation{#1}\gdef\ParallelStructureColor{\csname pt@navcolor@#1\endcsname}%

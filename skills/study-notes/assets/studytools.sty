  page-label-right .code:n = \renewcommand\StudyPageLabelRight{#1},
  notes-label-left .code:n = \renewcommand\StudyNotesLabelLeft{#1},
  notes-label-right .code:n = \renewcommand\StudyNotesLabelRight{#1},
  section-label-left .code:n = \renewcommand\StudySectionLabelLeft{#1},
  section-label-right .code:n = \renewcommand\StudySectionLabelRight{#1},
  unknown-label-left .code:n = \renewcommand\StudyUnknownLabelLeft{#1},
  unknown-label-right .code:n = \renewcommand\StudyUnknownLabelRight{#1},
  return-label-left .code:n = \renewcommand\StudyReturnLabelLeft{#1},
  return-label-right .code:n = \renewcommand\StudyReturnLabelRight{#1},
  continue-label-left .code:n = \renewcommand\StudyContinueLabelLeft{#1},
  continue-label-right .code:n = \renewcommand\StudyContinueLabelRight{#1}
 }

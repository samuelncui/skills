\newcommand\PTRestoreColumns{}
\makeatletter
\newcommand\PTSaveColumns{\if@twocolumn\let\PTRestoreColumns\twocolumn\else\let\PTRestoreColumns\relax\fi}
\makeatother
\NewDocumentCommand\ParallelBlankPage{}{\clearpage\begingroup\PTBodyfalse\hypersetup{pageanchor=false}\PTBlankPage\endgroup}
\NewDocumentCommand\ParallelFrontCover{m m}{%
 \clearpage\PTSaveColumns\onecolumn\begingroup\PTBodyfalse\pagestyle{empty}\hypersetup{pageanchor=false}\thispagestyle{empty}%
